# Bridge Rescue — environment configuration
# Copy to .env and fill in. Never commit .env.

# Wallet that receives x402 payments (your X Layer address).
PAY_TO_ADDRESS=0x7716ea8a6c001afe4bc77e277e902a2676e8d527

# Price per paid call, in USDT.
PRICE_USD=0.01

# OKX facilitator credentials (REQUIRED for x402 enforcement).
# Get these from the OKX OnchainOS developer console.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Public URL of the deployed service (used for the agent card / A2A).
PUBLIC_URL=https://bridge-rescue.onrender.com

# Port (Render sets this automatically).
PORT=3000
